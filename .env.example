# ── 認証方式A (既定): Vertex AI + ADC ─────────────────────────
# 事前に WSL 上で以下を実行してください。
#   gcloud auth application-default login --no-launch-browser
#   gcloud config set project <your-project-id>
#   gcloud services enable aiplatform.googleapis.com
#
# プロジェクト ID は gcloud の既定値を自動で引き継ぐため、通常この .env は不要です。
# 固定したい場合や gcloud の既定と変えたい場合だけ設定してください。
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# ── 認証方式B: Gemini API キー (Google AI Studio) ──────────────
# GCP プロジェクトを用意せず手軽に使いたい場合。無料枠あり。
# https://aistudio.google.com/apikey で発行
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=your-api-key-here

# ── 任意 ───────────────────────────────────────────────────────
# GEMA_MODEL=gemini-3.7-flash
# GEMA_THINKING=MEDIUM
