{
  "_comment": "このファイルを .gema/config.json にコピーすると、このプロジェクトでの既定設定になります。ユーザー共通設定は ~/.config/gema/config.json です。",

  "model": "gemini-3.7-flash",
  "_auth": "vertex = Vertex AI + gcloud ADC (既定) / apikey = Google AI Studio の API キー",
  "auth": "vertex",

  "_project": "空なら gcloud config get-value project を自動で使います",
  "project": "",
  "location": "global",

  "temperature": 0.7,
  "thinkingLevel": "MEDIUM",
  "showThoughts": false,

  "autoApprove": false,
  "allowCommands": ["ls", "cat", "head", "tail", "wc", "pwd", "echo", "which", "grep", "rg", "find", "git", "npm", "node", "pnpm", "make"],
  "denyCommands": ["shutdown", "reboot", "poweroff", "mkfs", "dd", "sudo"],

  "maxIterations": 25,
  "shellTimeoutMs": 120000,
  "maxFileBytes": 524288,
  "allowOutsideWorkspace": false,

  "contextFileNames": ["GEMINI.md", "AGENTS.md", "CLAUDE.md", ".gema/instructions.md"]
}
